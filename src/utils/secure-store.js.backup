/**
 * XTerminal Pro 安全存储模块
 * 提供跨平台的加密存储能力
 *
 * 策略：
 * - Tauri环境：使用系统keyring（@tauri-apps/plugin-secure-storage）
 * - 浏览器环境：使用AES-GCM加密 + localStorage
 */

// 加密密钥管理
const ENCRYPTION_KEY_NAME = 'xt_secure_key'
const ENCRYPTION_SALT = 'XTerminalPro_SecureStorage_v1'

/**
 * 检测运行环境
 */
function isTauri() {
  return '__TAURI__' in window
}

/**
 * 生成或获取加密密钥
 * 使用 Web Crypto API 生成随机密钥
 */
async function getEncryptionKey() {
  try {
    // 尝试从sessionStorage获取已存在的密钥
    const storedKey = sessionStorage.getItem(ENCRYPTION_KEY_NAME)
    if (storedKey) {
      const keyData = JSON.parse(storedKey)
      return await crypto.subtle.importKey(
        'jwk',
        keyData,
        { name: 'AES-GCM' },
        true,
        ['encrypt', 'decrypt']
      )
    }

    // 生成新密钥
    const key = await crypto.subtle.generateKey(
      {
        name: 'AES-GCM',
        length: 256,
      },
      true,
      ['encrypt', 'decrypt']
    )

    // 导出并存储密钥到sessionStorage（会话结束时清除）
    const exportedKey = await crypto.subtle.exportKey('jwk', key)
    sessionStorage.setItem(ENCRYPTION_KEY_NAME, JSON.stringify(exportedKey))

    return key
  } catch (error) {
    console.error('Failed to get encryption key:', error)
    throw new Error('Encryption key generation failed')
  }
}

/**
 * AES-GCM 加密
 */
async function encryptData(data) {
  try {
    const key = await getEncryptionKey()
    const encoder = new TextEncoder()
    const encoded = encoder.encode(data)

    // 生成随机IV
    const iv = crypto.getRandomValues(new Uint8Array(12))

    const ciphertext = await crypto.subtle.encrypt(
      {
        name: 'AES-GCM',
        iv: iv,
      },
      key,
      encoded
    )

    return {
      ciphertext: btoa(String.fromCharCode(...new Uint8Array(ciphertext))),
      iv: btoa(String.fromCharCode(...iv)),
    }
  } catch (error) {
    console.error('Encryption failed:', error)
    throw new Error('Data encryption failed')
  }
}

/**
 * AES-GCM 解密
 */
async function decryptData(ciphertext, iv) {
  try {
    const key = await getEncryptionKey()
    const encryptedData = Uint8Array.from(atob(ciphertext), c => c.charCodeAt(0))
    const ivData = Uint8Array.from(atob(iv), c => c.charCodeAt(0))

    const decrypted = await crypto.subtle.decrypt(
      {
        name: 'AES-GCM',
        iv: ivData,
      },
      key,
      encryptedData
    )

    const decoder = new TextDecoder()
    return decoder.decode(decrypted)
  } catch (error) {
    console.error('Decryption failed:', error)
    return null
  }
}

/**
 * 统一存储接口
 */
class BrowserSecureStorage {
  constructor() {
    this.PREFIX = 'xt_secure_'
  }

  async set(key, value) {
    try {
      const json = JSON.stringify(value)
      const encrypted = await encryptData(json)
      localStorage.setItem(
        this.PREFIX + key,
        JSON.stringify(encrypted)
      )
      return true
    } catch (error) {
      console.error(`Failed to store ${key}:`, error)
      return false
    }
  }

  async get(key) {
    try {
      const raw = localStorage.getItem(this.PREFIX + key)
      if (!raw) return null

      const encrypted = JSON.parse(raw)
      const decrypted = await decryptData(encrypted.ciphertext, encrypted.iv)
      if (!decrypted) return null

      return JSON.parse(decrypted)
    } catch (error) {
      console.error(`Failed to retrieve ${key}:`, error)
      return null
    }
  }

  async remove(key) {
    localStorage.removeItem(this.PREFIX + key)
  }

  async clear() {
    // 清除所有以 PREFIX 开头的键
    const keys = []
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i)
      if (key?.startsWith(this.PREFIX)) {
        keys.push(key)
      }
    }
    keys.forEach(key => localStorage.removeItem(key))
  }
}

/**
 * Tauri环境安全存储实现（使用Stronghold）
 */
class TauriSecureStorage {
  constructor() {
    this.client = null
    this.vaultName = 'xterminal-pro'
  }

  async getClient() {
    if (!this.client) {
      try {
        // 动态导入Tauri Stronghold API（仅在Tauri环境加载）
        const { Stronghold } = await import('@tauri-apps/plugin-stronghold')
        this.client = await Stronghold.create(this.vaultName, 'xterminal-pro')
      } catch (error) {
        console.error('Failed to initialize Stronghold client:', error)
        throw error
      }
    }
    return this.client
  }

  async set(key, value) {
    try {
      const client = await this.getClient()
      await client.store(key, JSON.stringify(value))
      return true
    } catch (error) {
      console.error(`Failed to store ${key} in Stronghold:`, error)
      // 降级到浏览器存储
      const fallback = new BrowserSecureStorage()
      return fallback.set(key, value)
    }
  }

  async get(key) {
    try {
      const client = await this.getClient()
      const result = await client.load(key)
      return result ? JSON.parse(result) : null
    } catch (error) {
      console.error(`Failed to retrieve ${key} from Stronghold:`, error)
      // 尝试从浏览器存储读取
      const fallback = new BrowserSecureStorage()
      return fallback.get(key)
    }
  }

  async remove(key) {
    try {
      const client = await this.getClient()
      await client.delete(key)
    } catch (error) {
      console.error(`Failed to remove ${key} from Stronghold:`, error)
    }
  }

  async clear() {
    try {
      const client = await this.getClient()
      // Stronghold没有批量删除API，需要逐个删除已知键
      const knownKeys = [
        'pwd_*',  // 密码
        'bookmarks',
        'favorites',
        'scheduler_tasks',
      ]
      for (const key of knownKeys) {
        await this.remove(key)
      }
    } catch (error) {
      console.error('Failed to clear Stronghold storage:', error)
    }
  }
}

/**
 * 创建安全存储实例
 */
function createSecureStorage() {
  if (isTauri()) {
    return new TauriSecureStorage()
  }
  return new BrowserSecureStorage()
}

// 默认实例
export const secureStore = createSecureStorage()

// ============ 辅助函数 ============

/**
 * 密码存储辅助函数
 */
export async function storePassword(connectionId, password) {
  return secureStore.set(`pwd_${connectionId}`, password)
}

export async function getPassword(connectionId) {
  return secureStore.get(`pwd_${connectionId}`)
}

export async function removePassword(connectionId) {
  return secureStore.remove(`pwd_${connectionId}`)
}

/**
 * 书签存储辅助函数
 */
export async function storeBookmarks(bookmarks) {
  return secureStore.set('bookmarks', bookmarks)
}

export async function getBookmarks() {
  return secureStore.get('bookmarks')
}

/**
 * 收藏夹存储辅助函数
 */
export async function storeFavorites(favorites) {
  return secureStore.set('favorites', favorites)
}

export async function getFavorites() {
  return secureStore.get('favorites')
}

/**
 * 定时任务存储辅助函数
 */
export async function storeSchedulerTasks(tasks) {
  return secureStore.set('scheduler_tasks', tasks)
}

export async function getSchedulerTasks() {
  return secureStore.get('scheduler_tasks')
}